# Set these as Environment Variables in the Vercel dashboard for the
# backend project (Production/Preview/Development), not committed to git.

# Full connection string from your Postgres provider (Vercel Postgres/Neon,
# Supabase, Render Postgres, etc). Use the *pooled* connection string if
# your provider offers one — serverless functions open many short-lived
# connections, and an unpooled connection string can exhaust Postgres'
# connection limit under load.
DATABASE_URL=postgresql://postgres:Hk219287@host:5432/dbname

SECRET_KEY=change-me-to-a-random-value

# Comma-separated list of frontend origins allowed to call this API.
# Include both your production and Vercel preview-deployment URLs.
ALLOWED_ORIGINS=https://masterji-client.vercel.app

# Leave unset/false — Vercel already terminates HTTPS for you.
ENFORCE_HTTPS=false
